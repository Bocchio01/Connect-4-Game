# ========================================================
#  Doxygen template for Connect 4 project
# ========================================================

PROJECT_NAME           = "Connect 4 Game"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
QUIET                  = YES

# Collect all include and src folders from modules
INPUT                  = \
  @CMAKE_SOURCE_DIR@/core/include \
  @CMAKE_SOURCE_DIR@/core/src \
  @CMAKE_SOURCE_DIR@/network/protocol/include \
  @CMAKE_SOURCE_DIR@/network/protocol/src \
  @CMAKE_SOURCE_DIR@/network/server/include \
  @CMAKE_SOURCE_DIR@/network/server/src \

FILE_PATTERNS          = *.h *.hpp *.cpp
RECURSIVE              = YES

# Doxygen layout and style
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = NO

# Treat warnings properly
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
